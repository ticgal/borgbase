{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    {{ include('components/form/header.html.twig', {'in_twig': true, 'no_header': true}) }}

    <div class="row">
        <div class="row ps-4">

            {{ fields.textField(
                'server',
                item.fields['server'],
                labels['server'],
                options
            ) }}

            {{ fields.passwordField(
                'apikey',
                '',
                labels['apikey'],
                options|merge({
                    additional_attributes: {
                        'placeholder': has_apikey ? '********************' : '',
                        'autocomplete': 'new-password'
                    }
                })
            ) }}

            {% if connection %}
                {{ fields.htmlField(
                    'connection',
                    '<span class="text-success"><i class="me-2 ti ti-check"></i>' ~ labels['connected']|e ~ '</span>',
                    ''
                ) }}

                <div class="form-field row col-6 mb-2 pe-0 justify-content-end align-items-center">
                    <button class="btn w-auto" type="submit" name="reload" value="1">
                        <i class="ti ti-refresh"></i>
                        <span>{{ labels['reload'] }}</span>
                    </button>
                </div>
            {% elseif has_apikey %}
                {{ fields.htmlField(
                    'connection',
                    '<span class="text-danger"><i class="me-2 ti ti-x"></i>' ~ labels['unconnected']|e ~ '</span>',
                    ''
                ) }}
            {% endif %}

            {{ fields.dropdownYesNo(
                'match',
                item.fields['match'],
                labels['match'],
                options
            ) }}

        </div>
    </div>

    {{ include('components/form/buttons.html.twig') }}
</div>
