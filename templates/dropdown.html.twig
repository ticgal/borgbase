{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    <form method="post" action="{{ action }}" data-submit-once>
        <input type="hidden" name="id" value="{{ value }}" />
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

        <div class="row">
            <div class="row ps-4">
                <h2>{{ labels['notRegistered'] }}</h2>

                {% if canCreate %}
                    {{ fields.dropdownArrayField(
                        'repoId',
                        '',
                        elements,
                        labels['selectRepo'],
                        {'display_emptychoice': true}
                    ) }}
                {% endif %}
            </div>
        </div>

        {% if canCreate %}
            <div class="card-body mx-n2 mb-4 border-top d-flex flex-row-reverse align-items-start flex-wrap">
                <button class="btn btn-primary me-2" type="submit" name="assoc" value="1">
                    <i class="ti ti-link"></i>
                    <span>{{ labels['link'] }}</span>
                </button>
            </div>
        {% endif %}
    </form>
</div>
