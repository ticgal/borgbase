{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="asset">
    <form method="post" action="{{ action }}" data-submit-once>
        <input type="hidden" name="repoId" value="{{ data['borg_id'] }}" />
        <input type="hidden" name="computerId" value="{{ value }}" />

        <div class="row">
            <div class="row ps-4">
                {{ fields.readOnlyField('borg_name', data['borg_name'], labels['name']) }}
                {{ fields.readOnlyField('alertDays', data['alertDays'], labels['alertDays']) }}
                {{ fields.readOnlyField('borg_version', data['borg_version'], labels['version']) }}
                {{ fields.readOnlyField('compactionInterval', data['formatCompactionInterval'], labels['compactionInterval']) }}
                {{ fields.readOnlyField('region', data['region'], labels['region']) }}
                {{ fields.readOnlyField('compactionHour', data['formatCompactionHour'], labels['compactionHour']) }}
                {{ fields.readOnlyField('is_encrypted', data['is_encrypted'], labels['encryption']) }}
                {{ fields.readOnlyField('currentUsage', data['formatCurrentUsage'], labels['usage']) }}
                {{ fields.readOnlyField('createdAt', data['formatCreatedAt'], labels['createdAt']) }}
                {{ fields.readOnlyField('lastModified', data['formatLastModified'], labels['lastBackup']) }}
            </div>
        </div>

        <div class="card-body mx-n2 mb-4 border-top d-flex flex-row-reverse align-items-start flex-wrap">
            {% if canPurge %}
                <button class="btn btn-danger me-2" type="submit" name="unlink" value="1"
                    onclick="return confirm('{{ labels['confirmDeletion']|e('js') }}');">
                    <i class="ti ti-unlink"></i>
                    <span>{{ labels['unlink'] }}</span>
                </button>
            {% endif %}

            {% if canUpdate %}
                <button class="btn btn-primary me-2" type="submit" name="reload" value="1">
                    <i class="ti ti-refresh"></i>
                    <span>{{ labels['reload'] }}</span>
                </button>
            {% endif %}
        </div>
    </form>

    <div class="card-footer mx-n2 mb-n2 mt-2">
        <div class="row">
            <div class="col-sm-6 col-12">{{ data['footerDateCreation'] }}</div>
            <div class="col-sm-6 col-12">{{ data['footerDateMod'] }}</div>
        </div>
    </div>
</div>
